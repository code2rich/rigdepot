# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.go]
indent_style = tab
indent_size = 4

[{go.mod,go.sum,*.mod,*.sum}]
indent_style = tab

[Makefile]
indent_style = tab

[*.md]
# Two trailing spaces are a line break in Markdown.
trim_trailing_whitespace = false

[*.{sh,ps1}]
indent_size = 2

[{*.cmd,*.bat}]
end_of_line = crlf

# Fixtures are real-world samples; editors must leave them exactly as they are.
[**/testdata/**]
charset = unset
end_of_line = unset
insert_final_newline = unset
trim_trailing_whitespace = unset
indent_style = unset
indent_size = unset
