# Copy to .env (which Git ignores) and edit. Docker Compose reads it from the
# directory of compose.yaml.

# Required: the address people and the command-line program reach this server
# at. Sign-in callbacks, links in emails and cookie security depend on it.
RGD_BASE_URL=https://hub.example.com

# The image version. Pin the full version in production.
# RGD_VERSION=0.4.0

# The port on this machine that the reverse proxy forwards to.
# RGD_PORT=8080

# The address range of this project's network. Change it if it overlaps a
# network you already have; RGD_TRUSTED_PROXIES follows it.
# RGD_SUBNET=172.31.250.0/24

# The address ranges whose X-Forwarded-For the server believes, comma
# separated. The default is RGD_SUBNET: the reverse proxy on this machine
# reaches the container from there. Set it when the proxy is somewhere else.
# RGD_TRUSTED_PROXIES=172.31.250.0/24

# PostgreSQL instead of SQLite: uncomment this line and create the two files
# described in README.md.
# COMPOSE_FILE=compose.yaml:compose.postgres.yaml
