# Startup configuration of rgd-server, read by rigdepot-server.service. One
# VARIABLE=value per line. Every variable is described in
# https://github.com/code2rich/rigdepot/blob/main/docs/deploy.md#configuration
#
# After a change: systemctl restart rigdepot-server

# Required: the address people and the command-line program reach this server
# at, such as https://hub.example.com.
#RGD_BASE_URL=https://hub.example.com

# The server listens on this machine only (127.0.0.1:8080). With a reverse
# proxy that terminates HTTPS on this machine, say so:
#RGD_TRUSTED_PROXIES=127.0.0.1

# PostgreSQL instead of SQLite in /var/lib/rigdepot:
#RGD_DATABASE_URL=postgres://rigdepot:<placeholder: password>@db.example.com:5432/rigdepot
