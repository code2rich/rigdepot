{
  "mcpServers": {
    "rgd-contract-stdio": {
      "args": [
        "--stdio",
        "--log-level",
        "info"
      ],
      "command": "contract-mcp",
      "env": {
        "CONTRACT_MODE": "read-only"
      },
      "type": "stdio"
    },
    "rgd-contract-http": {
      "headers": {
        "X-Contract": "yes"
      },
      "type": "http",
      "url": "https://mcp.example.com/contract"
    },
    "rgd-contract-secret": {
      "headers": {
        "Authorization": "Bearer ${CONTRACT_TOKEN}"
      },
      "type": "http",
      "url": "https://secret.example.com/mcp"
    }
  }
}
