{
  "$schema": "https://opencode.ai/config.json",
  "model": "example/large-model",
  "mcp": {
    "tracker": {
      "type": "remote",
      "url": "https://tracker.example.com/mcp",
      "headers": {
        "Authorization": "Bearer {env:TRACKER_TOKEN}"
      }
    },
    "scratch": {
      "type": "local",
      "command": ["npx", "-y", "example-scratch-mcp"],
      "enabled": false
    },
    "rgd-contract-stdio": {
      "command": [
        "contract-mcp",
        "--stdio",
        "--log-level",
        "info"
      ],
      "environment": {
        "CONTRACT_MODE": "read-only"
      },
      "type": "local"
    },
    "rgd-contract-http": {
      "headers": {
        "X-Contract": "yes"
      },
      "type": "remote",
      "url": "https://mcp.example.com/contract"
    },
    "rgd-contract-secret": {
      "headers": {
        "Authorization": "Bearer {env:CONTRACT_TOKEN}"
      },
      "type": "remote",
      "url": "https://secret.example.com/mcp"
    }
  }
}
