{
  "$schema": "https://opencode.ai/config.json",
  // Default model for every project.
  "model": "example/large-model",
  "autoupdate": false,
  "share": "disabled",
  "instructions": ["~/notes/opencode-rules.md"],
  "permission": {
    "bash": "ask",
    "edit": "allow",
  },
  "mcp": {
    "servers": {
      /* Issue tracker of the team. */
      "tracker": {
        "type": "remote",
        "url": "https://tracker.example.com/mcp",
        "headers": {
          "Authorization": "Bearer {env:TRACKER_TOKEN}",
        },
      },
      "scratch": {
        "type": "local",
        "command": ["npx", "-y", "example-scratch-mcp"],
        "environment": {},
        "disabled": true,
      },
    },
  },
}
