# Build output
/dist/
/web/dist/
*.exe
*.test
*.out

# Local development state: sandbox home, sample data, previews
/.dev/

# Dependencies
node_modules/

# Local configuration and secrets
.env
.env.*
!.env.example
# Samples for the check rule that reports exactly these files.
!/builtin/checks/bundledenv/testdata/**/.env*
/deploy/secrets/*
!/deploy/secrets/README.md

# Editors and operating systems
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# Design documents, the prototype, the demo site and agent instructions are
# kept in a separate private repository. These entries stop a local copy from
# being committed here by accident.
/docs/
/prototype/
/site/
/brand/
/services/
/AGENTS.md
/CLAUDE.md
/LESSONS.md
