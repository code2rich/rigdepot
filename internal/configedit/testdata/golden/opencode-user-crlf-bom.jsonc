{
  "$schema": "https://opencode.ai/config.json",
  // The model I use most days.
  "model": "example/model-large",
  "theme": "system",
  /* Servers I added by hand. */
  "mcp": {
    "servers": {
      "docs": {
        "type": "remote",
        "url": "https://mcp.example.com/docs",
        "headers": {},
      }, // keep this one first
      "local-notes": {
        "type": "local",
        "command": ["node", "/home/example/notes/server.js"],
        "environment": {},
        "disabled": true,
      },
      "rgd-jira": {
        "command": [
          "/opt/example/bin/rgd",
          "mcp",
          "run",
          "jira"
        ],
        "environment": {
          "JIRA_URL": "https://jira.example.com"
        },
        "type": "local"
      },
    },
  },
  "permission": {
    "edit": "ask", // ask before editing
  },
}
