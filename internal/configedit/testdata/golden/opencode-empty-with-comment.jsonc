{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "servers": {
      // add servers here
      "rgd-jira": {
        "command": [
          "/opt/example/bin/rgd",
          "mcp",
          "run",
          "jira"
        ],
        "environment": {
          "JIRA_URL": "https://jira.example.com"
        },
        "type": "local"
      }
    }
  }
}
