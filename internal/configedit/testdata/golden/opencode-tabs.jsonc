{
	"$schema": "https://opencode.ai/config.json",
	"mcp": {
		"servers": {
			"docs": {
				"type": "remote",
				"url": "https://mcp.example.com/docs"
			},
			"rgd-jira": {
				"command": [
					"/opt/example/bin/rgd",
					"mcp",
					"run",
					"jira"
				],
				"environment": {
					"JIRA_URL": "https://jira.example.com"
				},
				"type": "local"
			}
		}
	}
}
